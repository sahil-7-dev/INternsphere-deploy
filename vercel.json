{
  "buildCommand": null,
  "outputDirectory": ".",

  "rewrites": [
    { "source": "/", "destination": "/Index.html" },
    { "source": "/api/gemini", "destination": "/api/gemini.js" },
    { "source": "/(.*)", "destination": "/$1" }
